# API gateway root. The backend serves everything under its own context path, which the API
# client appends, so this is the origin only.
VITE_SERVER_URL=http://localhost:8090
VITE_DOMAIN=http://localhost:5173

# AWS Cognito. The app client must be a public client with no secret, since a browser cannot
# hold one. The pool needs a custom:tenantId attribute and the role groups the API expects.
VITE_AWS_COGNITO_USER_POOL_ID=
VITE_AWS_COGNITO_USER_POOL_CLIENT_ID=
VITE_AWS_REGION=ap-south-1
